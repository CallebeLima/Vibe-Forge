{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(rm *)",
      "Bash(pip install *)",
      "Bash(npm install *)"
    ],
    "deny": [
      "Edit(./.env)",
      "Write(./.env)",
      "Read(./.env)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)"
    ]
  },
  "enabledPlugins": {
    "oh-my-claudecode@omc": true
  }
}
